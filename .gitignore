# Datos personales y material crudo: nunca salen del equipo del estudiante.
datos/crudos/
datos/procesados/*.parquet
*.sav
*.dta

# Credenciales
.env
.env.*
*.key
credenciales*
zotero_api*

# Entornos y cachés
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv/

# Salidas de render
_site/
*.docx.bak
.quarto/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Estado local del tesista, no del repositorio
.perfil-activo
entregables/_render/

# Salidas de las herramientas de verificación: se regeneran en cada corrida
registro/*.md
registro/*.json
registro/tablero.html
registro/_cache_red/
registro/registro_ia.jsonl

# Entregables del tesista
entregables/TEXTO/
entregables/DOCUMENTO/
