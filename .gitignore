# Datos personales y material crudo: nunca salen del equipo del estudiante.
datos/crudos/
datos/procesados/*.parquet
*.sav
*.dta

# Credenciales
.env
.env.*
*.key
credenciales*
zotero_api*

# Entornos y cachés
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv/

# Salidas de render
_site/
*.docx.bak
.quarto/

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Estado local del tesista, no del repositorio
.perfil-activo
entregables/_render/

# Salidas de las herramientas de verificación: se regeneran en cada corrida
registro/*.md
registro/*.json
registro/tablero.html
registro/_cache_red/
registro/registro_ia.jsonl

# Entregables del tesista
entregables/TEXTO/
entregables/DOCUMENTO/
entregables/datos_de_entrega.yaml

# Hooks: el intérprete depende de la máquina, lo escribe instalar_hooks
.claude/settings.local.json
registro/.etapa

/.quarto/
**/*.quarto_ipynb

# ---------------------------------------------------------------------------
# Los ejemplos son la excepcion, y tiene que ser explicita
# ---------------------------------------------------------------------------
# Las reglas de arriba protegen la tesis del tesista: sus datos crudos y su
# perfil activo son estado local y no se versionan. Los ejemplos de `ejemplos/`
# necesitan lo contrario, porque sin sus datos no se pueden verificar ni
# reproducir. Lo que llevan dentro no es de nadie:
#
#   - economia-cuantitativo: series publicas del Banco Mundial (CC BY 4.0).
#   - medicina-cualitativo: transcripciones FICTICIAS, sin participantes.
#
# Hay pruebas que comprueban que no entre nada con datos personales.
!ejemplos/*/datos/
!ejemplos/*/datos/crudos/
!ejemplos/*/datos/crudos/**
!ejemplos/*/.perfil-activo

# Ejemplos montados como proyecto: se regeneran con preparar_ejemplo.
.ejemplos-montados/
build/

# Los datos de entrega del EJEMPLO sí se versionan: el tesista es ficticio y
# sin ellos no se puede demostrar ni probar la generación de los entregables.
!ejemplos/*/entregables/
!ejemplos/*/entregables/datos_de_entrega.yaml
